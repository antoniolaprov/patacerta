# Copy to .env and adjust. Used by the API and the AI service.

# Infrastructure (localhost when running the apps outside Docker)
DATABASE_URL=postgresql://patacerta:patacerta@localhost:5432/patacerta
REDIS_URL=redis://localhost:6379

# Shared between the API (issues tokens) and the AI service (validates them)
JWT_SECRET=troque-este-segredo

CORS_ORIGINS=http://localhost:5173,http://localhost:4200
CLINIC_UTC_OFFSET=-03:00
CLINIC_TIMEZONE=America/Recife

# Language model used by the assistant: anthropic | ollama | openai
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5
# With LLM_PROVIDER=ollama (run `ollama pull qwen2.5:7b` first)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
# With LLM_PROVIDER=openai: any OpenAI-compatible API. Groq has a free tier
# (key at console.groq.com). For Gemini use
# https://generativelanguage.googleapis.com/v1beta/openai and a Gemini model.
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_API_KEY=
OPENAI_MODEL=openai/gpt-oss-120b

# Embeddings: local (multilingual model running on the server) | hash (offline, for tests)
EMBEDDINGS_PROVIDER=local
EMBEDDING_MODEL=Xenova/paraphrase-multilingual-MiniLM-L12-v2
