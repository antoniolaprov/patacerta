{
  "id": "PcRelacionamento",
  "name": "PataCerta · Agente de relacionamento (rotina diária)",
  "active": false,
  "settings": { "executionOrder": "v1", "timezone": "America/Recife" },
  "nodes": [
    {
      "id": "b1f0c1a2-0001-4a00-9000-000000000001",
      "name": "Nota",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [-60, -260],
      "parameters": {
        "width": 900,
        "height": 200,
        "content": "## Agente de relacionamento (contra o churn)\nTodo dia às 9h (ou no botão **Rodar agora**): busca na PataCerta os pets com vacina, vermífugo ou exame atrasado sem nada agendado e os clientes que sumiram. O **Agente redator** escreve uma mensagem por cliente a partir do histórico, propondo resolver tudo na mesma visita (upsell). A PataCerta registra a mensagem, avisa o tutor no app e devolve o texto do WhatsApp com o link que abre o chat da Pata. A equipe envia pelo link gerado no último nó."
      }
    },
    {
      "id": "b1f0c1a2-0001-4a00-9000-000000000002",
      "name": "Todo dia às 9h",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0],
      "parameters": { "rule": { "interval": [{ "field": "days", "triggerAtHour": 9 }] } }
    },
    {
      "id": "b1f0c1a2-0001-4a00-9000-000000000003",
      "name": "Rodar agora",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [0, 200],
      "parameters": {}
    },
    {
      "id": "b1f0c1a2-0001-4a00-9000-000000000004",
      "name": "Entrar na PataCerta",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [240, 100],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.PATACERTA_API_URL }}/auth/login",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ email: $env.PATACERTA_AGENT_EMAIL, password: $env.PATACERTA_AGENT_PASSWORD }) }}",
        "options": {}
      }
    },
    {
      "id": "b1f0c1a2-0001-4a00-9000-000000000005",
      "name": "Buscar clientes em risco",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [480, 100],
      "parameters": {
        "method": "GET",
        "url": "={{ $env.PATACERTA_AI_URL }}/agents/retention/candidates",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [{ "name": "Authorization", "value": "=Bearer {{ $json.accessToken }}" }]
        },
        "options": {}
      }
    },
    {
      "id": "b1f0c1a2-0001-4a00-9000-000000000006",
      "name": "Agente redator",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [720, 100],
      "parameters": {
        "promptType": "define",
        "text": "=Tutor: {{ $json.tutorName }}\nPet: {{ $json.petName }} ({{ $json.species }})\nObservações do cadastro: {{ $json.notes || 'nenhuma' }}\nMotivos do contato:\n{{ $json.reasons.map(r => '- ' + r).join('\\n') }}\nServiço sugerido: {{ $json.suggestedService }}\nHistórico recente:\n{{ $json.history || '- sem registros' }}",
        "options": {
          "systemMessage": "Você é o agente de relacionamento da clínica PataCerta e escreve mensagens de WhatsApp para tutores que a clínica está perdendo.\nTom caloroso e pessoal, português do Brasil, no máximo 3 frases, no máximo um emoji. Cite o pet pelo nome e o motivo do contato.\nSe houver mais de um cuidado pendente, ou se o pet já tiver uma visita marcada, proponha resolver tudo na mesma visita: é mais prático para o tutor e é o objetivo principal da mensagem.\nPode mencionar um detalhe do histórico que mostre cuidado, mas nunca faça diagnóstico nem indique remédio.\nTermine convidando para agendar. Não coloque links (o sistema adiciona). Responda só com o texto da mensagem."
        }
      }
    },
    {
      "id": "b1f0c1a2-0001-4a00-9000-000000000007",
      "name": "Modelo Groq",
      "type": "@n8n/n8n-nodes-langchain.lmChatGroq",
      "typeVersion": 1,
      "position": [720, 320],
      "parameters": { "model": "llama-3.3-70b-versatile", "options": { "temperature": 0.4 } },
      "credentials": { "groqApi": { "id": "PcGroqCredential", "name": "Groq (PataCerta)" } }
    },
    {
      "id": "b1f0c1a2-0001-4a00-9000-000000000008",
      "name": "Registrar na PataCerta",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1080, 100],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.PATACERTA_AI_URL }}/agents/retention/send",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "=Bearer {{ $('Entrar na PataCerta').first().json.accessToken }}" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ petId: $('Buscar clientes em risco').item.json.petId, tutorId: $('Buscar clientes em risco').item.json.tutorId, message: $json.output.trim() }) }}",
        "options": {}
      }
    },
    {
      "id": "b1f0c1a2-0001-4a00-9000-000000000009",
      "name": "Mensagens prontas para o WhatsApp",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [1320, 100],
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            { "id": "a1", "name": "prioridade", "type": "string", "value": "={{ $('Buscar clientes em risco').item.json.priority }}" },
            { "id": "a2", "name": "pet", "type": "string", "value": "={{ $('Buscar clientes em risco').item.json.petName }}" },
            { "id": "a3", "name": "tutor", "type": "string", "value": "={{ $('Buscar clientes em risco').item.json.tutorName }}" },
            { "id": "a4", "name": "motivos", "type": "string", "value": "={{ $('Buscar clientes em risco').item.json.reasons.join('; ') }}" },
            { "id": "a5", "name": "mensagem", "type": "string", "value": "={{ $json.whatsappText }}" },
            {
              "id": "a6",
              "name": "abrir_no_whatsapp",
              "type": "string",
              "value": "={{ $('Buscar clientes em risco').item.json.phone ? 'https://wa.me/55' + $('Buscar clientes em risco').item.json.phone.replace(/\\D/g, '') + '?text=' + encodeURIComponent($json.whatsappText) : 'sem telefone cadastrado' }}"
            }
          ]
        },
        "options": {}
      }
    }
  ],
  "connections": {
    "Todo dia às 9h": { "main": [[{ "node": "Entrar na PataCerta", "type": "main", "index": 0 }]] },
    "Rodar agora": { "main": [[{ "node": "Entrar na PataCerta", "type": "main", "index": 0 }]] },
    "Entrar na PataCerta": { "main": [[{ "node": "Buscar clientes em risco", "type": "main", "index": 0 }]] },
    "Buscar clientes em risco": { "main": [[{ "node": "Agente redator", "type": "main", "index": 0 }]] },
    "Modelo Groq": { "ai_languageModel": [[{ "node": "Agente redator", "type": "ai_languageModel", "index": 0 }]] },
    "Agente redator": { "main": [[{ "node": "Registrar na PataCerta", "type": "main", "index": 0 }]] },
    "Registrar na PataCerta": { "main": [[{ "node": "Mensagens prontas para o WhatsApp", "type": "main", "index": 0 }]] }
  }
}
